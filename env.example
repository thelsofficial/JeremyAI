# Copy to .env (or export these) before starting JeremyAI.
ANTHROPIC_API_KEY=sk-ant-...
# Optional
PORT=3000
JEREMYAI_MODEL=claude-opus-5-5
JEREMYAI_EFFORT=medium        # low | medium | high | xhigh | max
RATE_LIMIT_PER_MINUTE=20
# DEMO_MODE=true              # force canned replies (auto-on when no key is set)
